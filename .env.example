# ==============================================================================
# EconWaAi Platform Environment Variables Template
# Copy to .env for local development
# ==============================================================================

# Application Profile & Server
SPRING_PROFILES_ACTIVE=local
PORT=8080

# PostgreSQL 16 Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=econwa_db
POSTGRES_USER=econwa_user
POSTGRES_PASSWORD=econwa_pass
DATABASE_URL=jdbc:postgresql://localhost:5432/econwa_db

# Redis 7 In-Memory & Session Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage (Proof of Delivery, Invoices, Voice Notes)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=econwa-media
S3_REGION=us-east-1

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Meta WhatsApp Cloud API (Section 20 Realism Task)
META_WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WA_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
META_WA_ACCESS_TOKEN=your_meta_system_user_token
META_WA_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_verify_token
META_WA_API_VERSION=v21.0

# Partner MFB Core Banking Integration (Section 20 Realism Task)
PARTNER_MFB_BASE_URL=https://sandbox.partnermfb.ng/api/v1
PARTNER_MFB_CLIENT_ID=your_mfb_client_id
PARTNER_MFB_CLIENT_SECRET=your_mfb_client_secret
PARTNER_MFB_WEBHOOK_SECRET=your_mfb_hmac_webhook_secret_key
PARTNER_MFB_INSTITUTION_CODE=MFB_001

# Identity & KYC Verification Provider (Prembly / Identitypass)
PREMBLY_BASE_URL=https://sandbox.myidentitypass.com/api/v1
PREMBLY_API_KEY=your_prembly_api_key
PREMBLY_APP_ID=your_prembly_app_id

# AI Whisper STT / NER Microservice
AI_CLIENT_SERVICE_URL=http://localhost:8000
AI_CLIENT_API_KEY=local-dev-whisper-key
